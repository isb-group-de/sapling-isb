{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "database/baseline/**",
        "exclude": "**/*.ts",
        "outDir": "dist"
      },
      {
        "include": "database/seeder/json-default/**",
        "outDir": "dist"
      },
      {
        "include": "database/seeder/seed-order.json",
        "outDir": "dist"
      },
      {
        "include": "database/seeder/json-demonstration/**",
        "outDir": "dist"
      },
      {
        "include": "database/seeder/json-production/**",
        "outDir": "dist"
      }
    ]
  }
}
