{
  "name": "backend",
  "version": "1.155.1450",
  "description": "",
  "author": "",
  "private": true,
  "license": "GPL-3.0",
  "mikro-orm": {
    "preferTs": true,
    "configPaths": [
      "./dist/database/mikro-orm.config.js",
      "./src/database/mikro-orm.config.ts"
    ]
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.build.tsbuildinfo",
    "build": "npm run clean && cross-env NODE_OPTIONS=--max-old-space-size=4096 nest build",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run clean && nest start",
    "start:dev": "npm run clean && cross-env NODE_OPTIONS=--max-old-space-size=4096 nest start --watch",
    "start:debug": "npm run clean && cross-env NODE_OPTIONS=--max-old-space-size=4096 nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096 node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "orm:create-migration": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npm run build && node dist/database/create-migration.js",
    "orm:migrate": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npm run build && cross-env UPDATE_MODE=migrate node dist/update.js",
    "orm:seed": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npm run build && cross-env UPDATE_MODE=seed node dist/update.js",
    "orm:deploy": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npm run build && cross-env UPDATE_MODE=all node dist/update.js",
    "admin:bootstrap": "cross-env NODE_ENV=production node dist/bootstrap-admin.js",
    "queues:clear-failed": "node dist/maintenance/clear-failed-queue-jobs.js",
    "telemetry:repair": "node dist/maintenance/repair-telemetry.js"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@google/generative-ai": "^0.24.1",
    "@kenjiuno/msgreader": "^1.28.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@mikro-orm/core": "^7.1.15",
    "@mikro-orm/decorators": "^7.1.15",
    "@mikro-orm/migrations": "^7.1.15",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.1.15",
    "@mikro-orm/reflection": "^7.1.15",
    "@mikro-orm/seeder": "^7.1.15",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/axios": "^12.0.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@oxc-node/core": "^0.1.0",
    "@simplewebauthn/server": "^14.0.0",
    "@types/passport-microsoft": "^2.1.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "googleapis": "^178.0.0",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.12",
    "log4js": "^6.9.1",
    "morgan": "^1.12.0",
    "openai": "^7.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "passport-microsoft": "^2.1.0",
    "postal-mime": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rotating-file-stream": "^3.2.10",
    "rxjs": "^7.8.2",
    "systeminformation": "^5.33.8",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@mikro-orm/cli": "^7.1.15",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "@humanfs/node": "0.16.8",
    "browserslist": "4.28.9",
    "gaxios": "7.3.1",
    "qs": "6.16.0",
    "test-exclude": "8.0.0"
  },
  "allowScripts": {
    "@google/genai@2.21.0": false,
    "@swc/core@1.16.2": true,
    "@parcel/watcher@2.6.0": false,
    "protobufjs@7.6.5": false,
    "bcrypt@6.0.0": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf": false
  }
}
